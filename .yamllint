---
extends: default
ignore: |
  .ansible/
  inventories/production/group_vars/vault.yml
rules:
  line-length:
    max: 110
    level: warning
  document-start: enable
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ['true', 'false']
